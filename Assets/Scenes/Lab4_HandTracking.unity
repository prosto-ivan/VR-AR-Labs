  m_Script: {fileID: 11500000, guid: 4d300611afcb09b4da0477332773fc04, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PCAssemblyController
  steps:
  - partName: "\u041C\u0430\u0442\u0435\u0440\u0438\u043D\u0441\u044C\u043A\u0430 \u043F\u043B\u0430\u0442\u0430"
    partDescription: "\u041C\u0430\u0442\u0435\u0440\u0438\u043D\u0441\u044C\u043A\u0430 \u043F\u043B\u0430\u0442\u0430 \u043E\u0431'\u0454\u0434\u043D\u0443\u0454 \u0432\u0441\u0456 \u043E\u0441\u043D\u043E\u0432\u043D\u0456 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0438\n\u043A\u043E\u043C\u043F'\u044E\u0442\u0435\u0440\u0430 \u0442\u0430 \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0443\u0454 \u0457\u0445\u043D\u044E \u0432\u0437\u0430\u0454\u043C\u043E\u0434\u0456\u044E"
    instruction: "\u0412\u0441\u0442\u0430\u043D\u043E\u0432\u0456\u0442\u044C \u043C\u0430\u0442\u0435\u0440\u0438\u043D\u0441\u044C\u043A\u0443 \u043F\u043B\u0430\u0442\u0443 \u0443 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0435 \u043C\u0456\u0441\u0446\u0435 \u043A\u043E\u0440\u043F\u0443\u0441\u0443"
    highlightMarker: {fileID: 1665398903}
  - partName: "\u041F\u0440\u043E\u0446\u0435\u0441\u043E\u0440 "
    partDescription: "\u041F\u0440\u043E\u0446\u0435\u0441\u043E\u0440 \u0432\u0438\u043A\u043E\u043D\u0443\u0454 \u043E\u0431\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044F \u0442\u0430 \u043E\u0431\u0440\u043E\u0431\u043B\u044F\u0454 \u043A\u043E\u043C\u0430\u043D\u0434\u0438 \u043F\u0440\u043E\u0433\u0440\u0430\u043C"
    instruction: "\u0412\u0441\u0442\u0430\u043D\u043E\u0432\u0456\u0442\u044C \u043F\u0440\u043E\u0446\u0435\u0441\u043E\u0440 \u0443 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u0438\u0439 \u0440\u043E\u0437'\u0454\u043C \u043C\u0430\u0442\u0435\u0440\u0438\u043D\u0441\u044C\u043A\u043E\u0457 \u043F\u043B\u0430\u0442\u0438"
    highlightMarker: {fileID: 1918601425}
  - partName: "\u0412\u0456\u0434\u0435\u043E\u043A\u0430\u0440\u0442\u0430"
    partDescription: "\u0422\u0443\u0442 \u0442\u0435\u043A\u0441\u0442 \u043F\u0440\u043E \u0442\u0435 \u0449\u043E \u0442\u0430\u043A\u0435 \u0432\u0456\u0434\u0435\u043E\u043A\u0430\u0440\u0442\u0430\t\t"
    instruction: "\u0422\u0443\u0442 \u043F\u0440\u043E \u0442\u0435 \u044F\u043A \u0457\u0457 \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0438"
